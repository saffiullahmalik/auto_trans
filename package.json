{
  "name": "auto-trans",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that helps teachers translate SundarSTEM questions into Urdu/Sindhi with AI suggestions.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit/*.test.js",
    "e2e": "node tests/e2e/run.mjs",
    "package": "node scripts/build.mjs && cd extension && zip -qr ../auto-trans-extension.zip . -x '*.map'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "katex": "0.16.11"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
